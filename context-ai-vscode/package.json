{
  "name": "context-ai-chat",
  "displayName": "Context-AI Chat",
  "description": "Chat interface for Context-AI - AI-powered codebase question answering",
  "version": "0.1.0",
  "publisher": "context-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabemule/context-ai.git"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p ./",
    "build:webview": "vite build",
    "dev": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "tsc -p ./ --watch",
    "watch:webview": "vite build --watch",
    "compile": "npm run build",
    "watch": "npm run dev",
    "package": "vsce package --out dist/",
    "install": "npm run package && code --install-extension dist/*.vsix",
    "deploy": "npm run build && npm run package",
    "clean": "rm -rf out dist node_modules/.vite"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextAiContainer",
          "title": "Context-AI",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "contextAiContainer": [
        {
          "id": "contextAiChat",
          "name": "Chat",
          "type": "webview",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "context-ai.openChat",
        "title": "Open Context-AI Chat",
        "category": "Context-AI",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "context-ai.openChat",
          "when": "resourceExtname",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "context-ai.openChat",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c"
      }
    ]
  },
  "dependencies": {
    "@types/markdown-it": "^14.0.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.2.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.3"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "keywords": [
    "ai",
    "chat",
    "context",
    "claude",
    "assistant"
  ],
  "license": "MIT"
}
