# =============================================================================
# Context-AI Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Required: Anthropic API key for Claude AI features (ask, chat commands)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Set to "true" when running from VS Code extension
# (automatically set by the extension — you don't need to set this manually)
# CONTEXT_AI_VSCODE=true
